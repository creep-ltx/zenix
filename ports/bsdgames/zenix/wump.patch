+	/* Zenix: no fork; the shell runs the pager with the file as its input */
+	{
+		char cmd[256];
+
+		(void)pid; (void)status; (void)fd;
+		(void)snprintf(cmd, sizeof(cmd), "%s < %s", pager, _PATH_WUMPINFO);
+		(void)system(cmd);
 	}
 }
 
