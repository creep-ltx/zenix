# zdesk's keys (DESIGN D38 step 5; docs/man/zdesk.txt "KEYS"). A user's ~/.config/zdesk/keys replaces this file.
# KEYS ACTION [ARGUMENTS]: KEYS are modifiers (lamiga, ramiga, shift, ctrl, alt) and one key joined by "+".
# Amiga+F1..F10 stay the console switches and cannot be used here.
lamiga+return       terminal
lamiga+q            close
lamiga+m            minimise
lamiga+z            zoom
lamiga+tab          next
lamiga+space        menu
lamiga+left         move -8 0
lamiga+right        move 8 0
lamiga+up           move 0 -8
lamiga+down         move 0 8
lamiga+shift+left   resize -8 0
lamiga+shift+right  resize 8 0
lamiga+shift+up     resize 0 -8
lamiga+shift+down   resize 0 8
lamiga+1            workspace 1
lamiga+2            workspace 2
lamiga+3            workspace 3
lamiga+4            workspace 4
lamiga+5            workspace 5
lamiga+6            workspace 6
lamiga+7            workspace 7
lamiga+8            workspace 8
lamiga+9            workspace 9
lamiga+shift+1      sendto 1
lamiga+shift+2      sendto 2
lamiga+shift+3      sendto 3
lamiga+shift+4      sendto 4
lamiga+shift+5      sendto 5
lamiga+shift+6      sendto 6
lamiga+shift+7      sendto 7
lamiga+shift+8      sendto 8
lamiga+shift+9      sendto 9
