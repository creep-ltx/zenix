# Zenix on an A1200 with 4 MB fast RAM whose ROOT filesystem is ZenixFS (partition 1 of build/zenix-zroot.hdf, RDB type zenixfs).
# Booted by the test-only kernel with the ZenixFS server built in (zenix-zfs.adf, DESIGN D19 step 1).
[fs-uae]
accuracy = 1
amiga_model = A1200
kickstart_file = $ZENIX_KICKSTART_DIR/kicka1200.rom
chip_memory = 2048
fast_memory = 4096
floppy_drive_0 = ../build/zenix-zfs.adf
floppy_drive_speed = 0
serial_port = /tmp/zenix-serial
uae_serial_direct = true
hard_drive_0 = ../build/zenix-zroot.hdf
hard_drive_0_controller = ide0
window_width = 960
window_height = 768
zoom = full
joystick_port_0 = none
joystick_port_1 = none
