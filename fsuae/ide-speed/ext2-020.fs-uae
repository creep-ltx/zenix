# tools/ide-speed-test.sh (ext2-020): disk throughput on the Gayle IDE port, a 68EC020 at 14 MHz with 4 MB fast RAM (the minimum),
# the root ext2 with 1 KB blocks. Emulator figures only.
[fs-uae]
accuracy = 1
amiga_model = A1200
kickstart_file = $ZENIX_KICKSTART_DIR/kicka1200.rom
chip_memory = 2048
fast_memory = 4096
floppy_drive_0 = ../../build/zenix.adf
floppy_drive_speed = 0
serial_port = /tmp/zenix-serial
uae_serial_direct = true
hard_drive_0 = ../../build/ide-speed-ext2.hdf
hard_drive_0_controller = ide0
window_width = 960
window_height = 768
zoom = full
joystick_port_0 = none
joystick_port_1 = none
