# tools/ide-speed-test.sh (zfs-020): disk throughput on the Gayle IDE port, a 68EC020 at 14 MHz with 4 MB fast RAM (the minimum),
# the root ZenixFS with 4 KB blocks (as on a big CF card), booted by the test-only kernel-zfs. Emulator figures only.
[fs-uae]
accuracy = 1
amiga_model = A1200
kickstart_file = $ZENIX_KICKSTART_DIR/kicka1200.rom
chip_memory = 2048
fast_memory = 4096
floppy_drive_0 = ../../build/zenix-zfs.adf
floppy_drive_speed = 0
serial_port = /tmp/zenix-serial
uae_serial_direct = true
hard_drive_0 = ../../build/ide-speed-zfs.hdf
hard_drive_0_controller = ide0
window_width = 960
window_height = 768
zoom = full
joystick_port_0 = none
joystick_port_1 = none
