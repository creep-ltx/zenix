# Disk-tool tests: boots the RAM-disk floppy (so the IDE disk is free to experiment on)
# with a blank scratch disk on the IDE port.
[fs-uae]
accuracy = 1
amiga_model = A1200
kickstart_file = $ZENIX_KICKSTART_DIR/kicka1200.rom
chip_memory = 2048
fast_memory = 4096
floppy_drive_0 = ../../build/zenix-ram.adf
floppy_drive_speed = 0
hard_drive_0 = ../../build/scratch.hdf
hard_drive_0_controller = ide0
serial_port = /tmp/zenix-serial
uae_serial_direct = true
window_width = 960
window_height = 768
zoom = full
joystick_port_0 = none
joystick_port_1 = none
