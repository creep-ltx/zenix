# Negative test: 68030 WITHOUT MMU (i.e. a 68EC030) — the boot stub must
# refuse cleanly over serial instead of corrupting memory.
[fs-uae]
amiga_model = A3000
kickstart_file = /home/creep/UAE/ROM/kicka3000.rom
chip_memory = 2048
fast_memory = 8192
uae_cpu_model = 68030
uae_mmu_model = 0
uae_fpu_model = 68882
floppy_drive_0 = ../build/zenix.adf
floppy_drive_speed = 0
serial_port = /tmp/zenix-serial
uae_serial_direct = true
